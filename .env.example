# ==============================================================================
# Telegram Signal Paper Trading System - Environment Configuration
# ==============================================================================

# Application & Environment
APP_ENV=development
LOG_LEVEL=INFO
DEBUG=true
JSON_LOGS=false

# Persistent Storage Configuration
DATA_DIR=./data

# Database Configuration (Defaults to ${DATA_DIR}/paper_trading.db if omitted)
# DATABASE_URL=sqlite+aiosqlite:///./data/paper_trading.db
# PostgreSQL Example: postgresql+asyncpg://user:password@localhost:5432/paper_trading

# ==============================================================================
# Telegram Client & Ingestion Configuration
# ==============================================================================
# Set TELEGRAM_MOCK_MODE=true to run development pipeline without connecting to Telegram
TELEGRAM_MOCK_MODE=false

# Obtain Telegram API ID & Hash from https://my.telegram.org
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION=paper_trading_session
TELEGRAM_PHONE=

# Target VIP Channel / Group ID (e.g., -1001234567890 or @channel_username)
TELEGRAM_SOURCE_CHAT_ID=

# Retry & Backoff Configuration
TELEGRAM_RETRY_ATTEMPTS=5
TELEGRAM_RETRY_DELAY=3.0

# ==============================================================================
# Market Data Configuration
# ==============================================================================
MARKET_DATA_PROVIDER=simulated # 'simulated', 'twelvedata', 'yfinance'
TWELVEDATA_API_KEY=

# ==============================================================================
# Risk & SL/TP Rules (Paper Trading Only)
# ==============================================================================
DEFAULT_TP_R_MULTIPLE=2.0
ALTERNATIVE_TP_R_MULTIPLES=[1.0, 1.5, 2.0, 3.0]
PAPER_TRADING_ENABLED=true
CONFIGURED_STRATEGY_SL_ENABLED=false
DEFAULT_SL_PIPS=30.0

# Virtual Account Defaults
INITIAL_ACCOUNT_BALANCE=10000.00
DEFAULT_RISK_PERCENT=1.0
